<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Política explícita de extracción y respaldo de MiPlata (Android 12+):
         - La base de datos Room (domain="database", mi_plata_colombia.db) SÍ se respalda y transfiere por defecto.
         - Las preferencias compartidas (domain="sharedpref", incluyendo mi_plata_prefs.xml con hash/sal del PIN
           e intentos fallidos y mi_plata_widget_cache.xml) se excluyen explícitamente en la nube y transferencia. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
