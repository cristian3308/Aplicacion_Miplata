<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Política explícita de respaldo de MiPlata (Android 11 e inferiores):
         - La base de datos Room (domain="database", mi_plata_colombia.db) SÍ se permite respaldar por defecto.
         - Las preferencias compartidas (domain="sharedpref", incluyendo mi_plata_prefs.xml con hash/sal del PIN
           e intentos fallidos y mi_plata_widget_cache.xml) se excluyen explícitamente de la copia en la nube. -->
    <exclude domain="sharedpref" path="." />
</full-backup-content>
